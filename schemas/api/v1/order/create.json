{
   "$id":"API_V1_CreateOrder",
   "$schema":"http://json-schema.org/draft-07/schema#",
   "title":"createOrder",
   "type":"object",
   "properties":{
      "client":{
         "type":"object",
         "properties":{
            "name":{
               "id": "clientName",
               "type":"string",
               "description":"The client name",
               "minLength":2,
               "maxLength":50
            }
         },
         "required":[
            "name"
         ]
      },
      "products":{
         "type":"array",
         "minItems":1,
         "items":{
            "type":"object",
            "properties":{
               "id":{
                  "id": "productId",
                  "description":"The product id",
                  "type":"integer",
                  "minimum":1
               },
               "quantity":{
                  "id": "productQuantity",
                  "description":"The product quantity",
                  "type":"integer",
                  "minimum":1
               }
            },
            "required":[
               "id",
               "quantity"
            ]
         }
      }
   },
   "required":[
      "client",
      "products"
   ]
}