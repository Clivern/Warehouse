{
   "$id":"API_V1_LoadArticles",
   "$schema":"http://json-schema.org/draft-07/schema#",
   "title":"loadArticles",
   "type":"object",
   "properties":{
      "inventory":{
         "type":"array",
         "minItems":1,
         "items":{
            "type":"object",
            "properties":{
               "art_id":{
                  "id": "articleId",
                  "type":"string",
                  "description":"The article identifier",
                  "minLength":1,
                  "maxLength":50
               },
               "name":{
                  "id": "articleName",
                  "type":"string",
                  "description":"The article name",
                  "minLength":1,
                  "maxLength":50
               },
               "stock":{
                  "id": "stock",
                  "type":"string",
                  "description":"The article quantity",
                  "minLength":1,
                  "maxLength":15
               }
            },
            "required":[
               "art_id",
               "name",
               "stock"
            ]
         }
      }
   },
   "required":[
      "inventory"
   ]
}