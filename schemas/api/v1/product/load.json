{
   "$id":"API_V1_LoadProducts",
   "$schema":"http://json-schema.org/draft-07/schema#",
   "title":"loadProducts",
   "type":"object",
   "properties":{
      "products":{
         "type":"array",
         "minItems":1,
         "items":{
            "type":"object",
            "properties":{
               "name":{
                  "id": "productName",
                  "type":"string",
                  "description":"The product name",
                  "minLength":1,
                  "maxLength":50
               },
               "contain_articles":{
                  "type":"array",
                  "minItems":1,
                  "items":{
                     "type":"object",
                     "properties":{
                        "art_id":{
                           "id": "articleId",
                           "type":"string",
                           "description":"The article identifier",
                           "minLength":1,
                           "maxLength":50
                        },
                        "amount_of":{
                           "id": "articleAmount",
                           "type":"string",
                           "description":"The article amount",
                           "minLength":1,
                           "maxLength":15
                        }
                     },
                     "required":[
                        "art_id",
                        "amount_of"
                     ]
                  }
               }
            },
            "required":[
               "name",
               "contain_articles"
            ]
         }
      }
   },
   "required":[
      "products"
   ]
}